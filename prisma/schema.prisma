// ---------------------------------------------------------------------------
// Modelo de dados
//
// Regra central do domínio:
//   Task          = O QUE precisa ser feito (não tem horário).
//   ScheduleBlock = QUANDO pretendo executar (tem horário).
// São entidades separadas, ligadas por uma relação 1:N (uma Task pode ser
// executada em várias sessões).
//
// Convenções:
//   - Tabelas e colunas em snake_case (via @map/@@map) para SQL legível.
//   - Todo instante é `timestamptz(3)` (UTC no banco, precisão de ms = JS Date).
//   - `due_date` é `date` (data civil, SEM horário). Ver docs/ARCHITECTURE.md.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Usuário
// ---------------------------------------------------------------------------

model User {
  id String @id @default(uuid(7)) @db.Uuid

  email String  @unique
  name  String?

  /// Timezone IANA do usuário (ex.: "America/Sao_Paulo").
  /// É a ÚNICA fonte de verdade para fronteiras de dia (Hoje, heatmap, streak).
  /// Nunca derivar o dia a partir do relógio do navegador.
  timeZone String @default("America/Sao_Paulo") @map("time_zone")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tasks     Task[]
  projects  Project[]
  reminders Reminder[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Projeto / Área
// ---------------------------------------------------------------------------

model Project {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name String
  /// Cor em hex (#RRGGBB) para identificação visual na agenda.
  color String?

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
  @@map("projects")
}

// ---------------------------------------------------------------------------
// Task — o QUE fazer
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  DONE

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

model Task {
  id     String  @id @default(uuid(7)) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  /// Opcional: tarefa sem projeto é uma tarefa solta (típico da Inbox).
  /// A posse do projeto é validada na camada de serviço (ver ARCHITECTURE.md).
  projectId String? @map("project_id") @db.Uuid

  title       String
  description String?

  /// Estimativa de esforço em minutos. OBRIGATÓRIO: duração é pilar do produto.
  /// Não confundir com a duração do ScheduleBlock (a alocação real na agenda).
  estimatedMinutes Int @map("estimated_minutes")

  priority TaskPriority @default(MEDIUM)

  /// Prazo: "preciso terminar até tal DIA". Data civil, sem horário.
  /// NUNCA usar como horário de início — isso é papel do ScheduleBlock.
  dueDate DateTime? @map("due_date") @db.Date

  status      TaskStatus @default(TODO)
  completedAt DateTime?  @map("completed_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scheduleBlocks ScheduleBlock[]
  reminders      Reminder[]

  /// Alvo da FK composta de ScheduleBlock: garante no banco que um bloco
  /// nunca aponte para a tarefa de outro usuário.
  @@unique([id, userId])
  @@index([userId, status, createdAt])
  @@index([userId, dueDate])
  @@index([userId, projectId])
  @@map("tasks")
}

// ---------------------------------------------------------------------------
// ScheduleBlock — QUANDO executar
// ---------------------------------------------------------------------------

model ScheduleBlock {
  id String @id @default(uuid(7)) @db.Uuid

  /// Desnormalizado a partir de Task.userId para permitir varreduras por
  /// usuário/período sem join. A FK composta abaixo garante a coerência.
  userId String @map("user_id") @db.Uuid
  taskId String @map("task_id") @db.Uuid

  /// Intervalo semiaberto [startsAt, endsAt): 14:00-15:00 e 15:00-16:00
  /// NÃO conflitam. Ver docs/PRODUCT.md.
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// FK composta -> Task(id, user_id). Cascateia de User via Task.
  task      Task       @relation(fields: [taskId, userId], references: [id, userId], onDelete: Cascade)
  reminders Reminder[]

  @@index([userId, startsAt])
  @@index([taskId])
  @@map("schedule_blocks")
}

// ---------------------------------------------------------------------------
// Reminder — notificações (modelado agora, entregue depois)
// ---------------------------------------------------------------------------

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  CANCELED

  @@map("reminder_status")
}

model Reminder {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Exatamente UM dos dois é preenchido (CHECK no banco):
  ///   scheduleBlockId -> lembrete de execução ("hora de começar").
  ///   taskId          -> lembrete de prazo ("vence hoje").
  taskId          String? @map("task_id") @db.Uuid
  scheduleBlockId String? @map("schedule_block_id") @db.Uuid

  remindAt DateTime       @map("remind_at") @db.Timestamptz(3)
  status   ReminderStatus @default(PENDING)
  sentAt   DateTime?      @map("sent_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  scheduleBlock ScheduleBlock? @relation(fields: [scheduleBlockId], references: [id], onDelete: Cascade)

  /// Fila de disparo: "o que está pendente e já venceu".
  @@index([status, remindAt])
  @@index([userId, remindAt])
  @@map("reminders")
}
