# ---------------------------------------------------------------------------
# Copie para `.env`. O `.env` NÃO é versionado.
# ---------------------------------------------------------------------------
#
# Os valores abaixo são os do Supabase LOCAL. Eles são idênticos em toda
# instalação local do Supabase CLI — são chaves de desenvolvimento públicas,
# não segredos. Rode `npm run db:status` para confirmá-los na sua máquina.
#
# ---------------------------------------------------------------------------
# Cliente (Android / iOS / Web)
# ---------------------------------------------------------------------------
# Só variáveis com o prefixo EXPO_PUBLIC_ entram no bundle do app.
# Nunca coloque uma chave secreta com este prefixo.

EXPO_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

# Em dispositivo FÍSICO, 127.0.0.1 aponta para o próprio aparelho.
# Troque pelo IP da sua máquina na rede local, ex.:
# EXPO_PUBLIC_SUPABASE_URL="http://192.168.0.10:54321"

# ---------------------------------------------------------------------------
# Nenhuma chave secreta é necessária
# ---------------------------------------------------------------------------
# Os testes de RLS (`npm run test:db` / `npm run test:rls`) rodam com a MESMA
# chave publicável do aplicativo — de propósito. Se eles passam, é porque as
# policies funcionam de verdade, e não porque o teste tinha privilégio de
# `service_role` para contorná-las.
