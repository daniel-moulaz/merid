# ---------------------------------------------------------------------------
# Copie para `.env` e ajuste. NUNCA comite o `.env`.
# ---------------------------------------------------------------------------

# Banco de dados (corresponde ao docker-compose.yml deste repositório).
DATABASE_URL="postgresql://app:app_dev_password@localhost:5432/app_dev?schema=public"

# Banco usado pelos testes de integração (`npm run test:db`).
# PRECISA ser diferente do de desenvolvimento: os testes apagam todas as tabelas.
DATABASE_URL_TEST="postgresql://app:app_dev_password@localhost:5432/app_test?schema=public"

# ---------------------------------------------------------------------------
# Autenticação (provisória)
# ---------------------------------------------------------------------------
# Enquanto o login real não existe, o servidor resolve o usuário da sessão a
# partir deste e-mail. Precisa bater com um usuário existente no banco
# (`npm run db:seed` cria o padrão abaixo).
# Em produção esta variável deve ficar ausente: a ausência dela faz o app
# recusar requisições em vez de assumir um usuário.
DEV_USER_EMAIL="dev@localhost"

# Ambiente. `production` desativa o atalho de sessão de desenvolvimento.
NODE_ENV="development"
